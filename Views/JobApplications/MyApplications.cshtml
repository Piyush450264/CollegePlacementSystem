@model IEnumerable<CollegePlacementSystem.Models.JobApplication>

@{
    ViewData["Title"] = "My Applications";
    var applications = Model.ToList();
}

<div class="container py-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1">My Placement Applications</h1>
            <p class="text-secondary mb-0">
                Monitor review status, shortlisting progress, and selection outcomes for your job submissions.
            </p>
        </div>

        <a asp-controller="JobApplications"
           asp-action="AvailableJobs"
           class="btn btn-primary">
            <i class="bi bi-search me-1"></i> Browse More Jobs
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Applied</span>
                    <h2 class="fw-bold mb-0" style="color: var(--theme-brown-dark);">@applications.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Under Review</span>
                    <h2 class="fw-bold text-secondary mb-0">
                        @applications.Count(a => a.Status == "Applied")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Shortlisted</span>
                    <h2 class="fw-bold mb-0" style="color: var(--theme-blue);">
                        @applications.Count(a => a.Status == "Shortlisted")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Selected</span>
                    <h2 class="fw-bold text-success mb-0">
                        @applications.Count(a => a.Status == "Selected")
                    </h2>
                </div>
            </div>
        </div>
    </div>

    @if (!applications.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <div class="brand-icon-box mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="bi bi-folder2-open"></i>
            </div>
            <h4 class="fw-bold" style="color: var(--theme-brown-dark);">No Applications Yet</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 480px;">
                You have not submitted applications for any company drives yet. Browse the currently active placement opportunities to get started.
            </p>

            <div>
                <a asp-controller="JobApplications"
                   asp-action="AvailableJobs"
                   class="btn btn-primary px-4 py-2">
                    <i class="bi bi-briefcase me-1"></i> Explore Available Jobs
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Job Title</th>
                                <th>Company</th>
                                <th>Applied On</th>
                                <th>Status</th>
                                <th style="min-width: 180px;">Progress</th>
                            </tr>
                        </thead>

                        <tbody>
                        @foreach (var application in applications)
                        {
                            var statusClass = application.Status switch
                            {
                                "Applied" => "bg-secondary",
                                "Shortlisted" => "bg-info",
                                "Selected" => "bg-success",
                                "Rejected" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            var progressWidth = application.Status switch
                            {
                                "Applied" => "25%",
                                "Shortlisted" => "60%",
                                "Selected" => "100%",
                                "Rejected" => "100%",
                                _ => "0%"
                            };

                            var progressBarColor = application.Status switch
                            {
                                "Selected" => "background: #16804a;",
                                "Rejected" => "background: #c13438;",
                                "Shortlisted" => "background: linear-gradient(90deg, #0284c7, #38bdf8);",
                                _ => "background: #94a3b8;"
                            };

                            <tr>
                                <td>
                                    <span class="fw-bold" style="color: var(--theme-brown-dark);">
                                        @(application.Job?.JobTitle ?? "Job Position")
                                    </span>
                                </td>

                                <td>
                                    <i class="bi bi-building text-secondary me-1"></i>
                                    @(application.Job?.Company?.CompanyName ?? "Unknown Company")
                                </td>

                                <td>
                                    <span class="small text-secondary">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        @application.AppliedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @statusClass">
                                        @application.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="progress mb-1"
                                         role="progressbar"
                                         aria-label="Application progress"
                                         aria-valuemin="0"
                                         aria-valuemax="100"
                                         aria-valuenow="@int.Parse(progressWidth.TrimEnd('%'))"
                                         style="height: 8px; border-radius: 99px; background: #e2e8f0;">
                                        <div class="progress-bar rounded-pill"
                                             style="width: @progressWidth; @progressBarColor">
                                        </div>
                                    </div>

                                    <small class="text-secondary d-block" style="font-size: 0.78rem;">
                                        @(application.Status == "Applied"
                                            ? "Under initial review"
                                            : application.Status == "Shortlisted"
                                                ? "Candidate shortlisted"
                                                : application.Status == "Selected"
                                                    ? "Offer accepted / selected!"
                                                    : application.Status == "Rejected"
                                                        ? "Not selected for this role"
                                                        : "Status updated")
                                    </small>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-3 text-secondary small">
                Showing @applications.Count applications.
            </div>
        </div>
    }
</div>
