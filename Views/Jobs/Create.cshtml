@model CollegePlacementSystem.Models.Job

@{
    ViewData["Title"] = "Add New Job";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Jobs
        </a>
        <h1 class="fw-bold mt-3 mb-1">Post New Job</h1>
        <p class="text-secondary mb-0">Publish a campus recruitment drive and configure student eligibility criteria.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form asp-controller="Jobs" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="JobTitle" class="form-label">
                            <i class="bi bi-briefcase text-primary me-1"></i> Job Title
                        </label>
                        <input asp-for="JobTitle" class="form-control" placeholder="e.g. Graduate Software Trainee" />
                        <span asp-validation-for="JobTitle" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyId" class="form-label">
                            <i class="bi bi-building text-primary me-1"></i> Recruiting Company
                        </label>
                        <select asp-for="CompanyId"
                                asp-items="@(ViewBag.Companies as Microsoft.AspNetCore.Mvc.Rendering.SelectList)"
                                class="form-select">
                            <option value="">-- Select Company --</option>
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-card-text text-primary me-1"></i> Job Description & Roles
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide job details, key skills, and expectations..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EligibleDepartment" class="form-label">
                            <i class="bi bi-mortarboard text-primary me-1"></i> Eligible Department
                        </label>
                        <input asp-for="EligibleDepartment"
                               class="form-control"
                               placeholder="e.g. Computer Science or All Departments" />
                        <span asp-validation-for="EligibleDepartment" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MinimumCGPA" class="form-label">
                            <i class="bi bi-award text-primary me-1"></i> Minimum CGPA
                        </label>
                        <input asp-for="MinimumCGPA"
                               type="number"
                               step="0.01"
                               min="0"
                               max="10"
                               placeholder="7.00"
                               class="form-control" />
                        <span asp-validation-for="MinimumCGPA" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MaximumBacklogs" class="form-label">
                            <i class="bi bi-slash-circle text-primary me-1"></i> Maximum Backlogs
                        </label>
                        <input asp-for="MaximumBacklogs"
                               type="number"
                               min="0"
                               value="0"
                               class="form-control" />
                        <span asp-validation-for="MaximumBacklogs" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SalaryPackage" class="form-label">
                            <i class="bi bi-currency-rupee text-primary me-1"></i> Package (LPA)
                        </label>
                        <input asp-for="SalaryPackage"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="8.50"
                               class="form-control" />
                        <span asp-validation-for="SalaryPackage" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ApplicationDeadline" class="form-label">
                            <i class="bi bi-calendar-event text-primary me-1"></i> Application Deadline
                        </label>
                        <input asp-for="ApplicationDeadline"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="ApplicationDeadline" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 pt-2 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Save Job
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
