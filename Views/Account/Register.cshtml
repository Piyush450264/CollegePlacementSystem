@model CollegePlacementSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Student Registration";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white p-4 text-center">
                    <div class="brand-icon-box mx-auto mb-2" style="width: 50px; height: 50px; font-size: 1.5rem; background: #ffffff; color: var(--theme-brown);">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Student Registration</h3>
                    <p class="mb-0 text-white-50 small">Activate your student placement portal account</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-info d-flex align-items-start gap-2 mb-4">
                        <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
                        <span class="small">
                            Register using the exact <strong>email address</strong> and <strong>enrollment number</strong> already on record with your college department.
                        </span>
                    </div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">
                                <i class="bi bi-person text-primary me-1"></i> Full Name
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Alex Johnson" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">
                                    <i class="bi bi-envelope text-primary me-1"></i> College Email
                                </label>
                                <input asp-for="Email" class="form-control" placeholder="student@college.edu" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EnrollmentNumber" class="form-label">
                                    <i class="bi bi-card-text text-primary me-1"></i> Enrollment No.
                                </label>
                                <input asp-for="EnrollmentNumber" class="form-control" placeholder="e.g. EN2024CS001" />
                                <span asp-validation-for="EnrollmentNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">
                                    <i class="bi bi-lock text-primary me-1"></i> Password
                                </label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">
                                    <i class="bi bi-check2-circle text-primary me-1"></i> Confirm Password
                                </label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="p-2 mb-4 rounded-3" style="background: var(--theme-blue-subtle); border: 1px solid var(--theme-blue-border);">
                            <small class="text-secondary d-block">
                                <i class="bi bi-shield-check text-primary me-1"></i>
                                Password must be at least 8 characters and include uppercase, lowercase, a digit, and a special symbol.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fs-6">
                            <i class="bi bi-person-check-fill me-1"></i> Complete Registration
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-secondary small">Already registered?</span>
                        <a asp-action="Login" class="fw-bold small ms-1">Log in here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
