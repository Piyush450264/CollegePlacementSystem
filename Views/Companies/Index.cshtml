@model IEnumerable<CollegePlacementSystem.Models.Company>

@{
    ViewData["Title"] = "Company Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1">Company Management</h1>
            <p class="text-secondary mb-0">
                Manage recruiting partner organizations and their corporate contact details.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-building-add me-1"></i> Add Company
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Company Name</th>
                            <th>Industry Domain</th>
                            <th>Contact Email</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="bi bi-buildings fs-2 d-block mb-2"></i>
                                    No companies registered yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var company in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold" style="color: var(--theme-brown-dark);">
                                            <i class="bi bi-building me-1 text-primary"></i>
                                            @company.CompanyName
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@(company.Industry ?? "General")</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            @(company.ContactEmail != null ? company.ContactEmail : "—")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            @(company.ContactPhone != null ? company.ContactPhone : "—")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <a asp-action="Details"
                                               asp-route-id="@company.CompanyId"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@company.CompanyId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@company.CompanyId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-secondary small mt-3">
                Total companies: @Model.Count()
            </div>
        </div>
    </div>
</div>
