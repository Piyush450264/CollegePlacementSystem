@model IEnumerable<CollegePlacementSystem.Models.Student>

@{
    ViewData["Title"] = "Student Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1">Student Management</h1>
            <p class="text-secondary mb-0">
                Manage student academic profiles, contact details, and resumes.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Register Student
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Enrollment No.</th>
                            <th>Department</th>
                            <th>CGPA</th>
                            <th>Backlogs</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-5">
                                    <i class="bi bi-people fs-2 d-block mb-2"></i>
                                    No students registered yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold" style="color: var(--theme-brown-dark);">
                                            @student.FullName
                                        </div>
                                        <small class="text-secondary">
                                            <i class="bi bi-envelope me-1"></i>@student.Email
                                        </small>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @student.EnrollmentNumber
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-info">
                                            @student.Department
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge text-bg-primary">
                                            @student.CGPA.ToString("0.00")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @student.Backlogs
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <a asp-action="Details"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i> View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(student.ResumePath))
                                            {
                                                <a asp-action="DownloadResume"
                                                   asp-route-id="@student.StudentId"
                                                   class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-file-earmark-arrow-down"></i> Resume
                                                </a>
                                            }

                                            <a asp-action="Delete"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-secondary small mt-3">
                Total students: @Model.Count()
            </div>
        </div>
    </div>
</div>
